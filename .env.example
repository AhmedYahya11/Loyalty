# Loyalty Platform — deployment config. Copy to .env and set real secrets.
# ملف الإعدادات — انسخه إلى .env وضَع الأسرار الحقيقية.

# --- database ---
POSTGRES_DB=loyalty
POSTGRES_USER=loyalty
# Changing the password requires a fresh pgdata volume (the volume is initialized once).
POSTGRES_PASSWORD=change-me-strong-password

# --- api ---
# Strong, random; gates the one-time /api/v1/bootstrap endpoint.
BOOTSTRAP_TOKEN=change-me-random-bootstrap-token
# Signing key for dashboard admin JWTs (HS256), used by the api to issue + validate tokens.
# MUST be >=32 chars, strong and random. A dev fallback is used if unset — always set in prod.
JWT_SIGNING_KEY=change-me-at-least-32-random-characters
# Comma-separated allowed browser origins for the dashboard ("*" = any; lock down in prod).
CORS_ORIGINS=http://localhost:3000
ASPNETCORE_ENVIRONMENT=Production

# --- event broker (Wolverine transport) ---
# rabbitmq (default) uses the rabbitmq service; set to "postgres" to use the in-DB queue.
LOYALTY_BROKER=rabbitmq
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=change-me-strong-rabbit-password

# --- dashboard (baked into the client bundle at build time) ---
DASHBOARD_API_BASE=http://localhost:8080
# Optional: a tenant API key for turnkey auto-connect; leave blank to connect via the UI.
DASHBOARD_API_KEY=

# --- first-run dashboard SuperAdmin (seeded once against the root application) ---
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=change-me-strong-admin-password
